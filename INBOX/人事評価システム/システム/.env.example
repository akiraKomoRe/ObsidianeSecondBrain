# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key -- server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API key, used to generate weekly AI evaluations
ANTHROPIC_API_KEY=
# Optional: override the default model (claude-sonnet-5)
ANTHROPIC_MODEL=

# Shared secret for the weekly batch-evaluation cron job
# (Vercel Cron sends this automatically as `Authorization: Bearer <value>`)
CRON_SECRET=
